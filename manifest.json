{
  "manifest_version": 3,
  "name": "LLM Bridge",
  "version": "1.0",
  "description": "Scrape, optimize with Gemini, and chunk live LLM chat context.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "<all_urls>"
  ]
}